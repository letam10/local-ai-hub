      "schema_version": "creative-recipe.v1",
      "id": "recipe_short_video_concept",
      "version": "1.0.0",
      "label": "Short video concept",
      "description": "A bounded short-video storyboard prompt for planning camera motion and duration.",
      "author": "Local AI Hub",
      "license": "CC0-1.0",
      "media_kind": "video",
      "prompt_template": "A concise cinematic shot of {{slot_subject}}, {{slot_camera_move}}, coherent motion, clear beginning and end",

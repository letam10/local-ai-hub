{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-ai-hub/v7-production-catalog.v2",
  "title": "Local AI Hub V7 production catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "models", "runtimes"],
  "properties": {
    "schema_version": {"const": "v7-production-catalog.v2"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$"},
    "models": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/model"}},
    "runtimes": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/runtime"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,95}$"},
    "relative": {"type": "string", "pattern": "^(?![\\/])(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$))(?!.*:)(?!.*\\\\)[^\\u0000-\\u001f]+$"},
    "public_url": {"type": ["string", "null"], "pattern": "^https://"},
    "nullable_text": {"type": ["string", "null"], "maxLength": 256},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "kind", "canonical_identity", "revision", "verification_state", "url", "authentication_required", "license_required"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 96},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "canonical_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": ["string", "null"], "maxLength": 128},
        "verification_state": {"enum": ["verified", "unverified", "manual", "auth_required", "unsupported", "unknown"]},
        "url": {"$ref": "#/$defs/public_url"},
        "authentication_required": {"type": "boolean"},
        "license_required": {"type": "boolean"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "spdx_id", "url"],
      "properties": {
        "state": {"enum": ["review_required", "apache-2.0", "gpl-3.0-or-later", "gated", "unknown"]},
        "spdx_id": {"type": ["string", "null"], "maxLength": 64},
        "url": {"$ref": "#/$defs/public_url"}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "state"],
      "properties": {"required": {"type": "boolean"}, "state": {"enum": ["not_required", "required", "unknown"]}}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification"],
      "properties": {
        "verification": {"enum": ["verified", "unverified"]},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"verification": {"const": "verified"}}}, "then": {"required": ["size_bytes", "sha256"]}},
        {"if": {"properties": {"verification": {"const": "unverified"}}}, "then": {"not": {"anyOf": [{"required": ["size_bytes"]}, {"required": ["sha256"]}]}}}
      ]
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "verification"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relative"},
        "verification": {"enum": ["verified", "unverified"]},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"verification": {"const": "verified"}}}, "then": {"required": ["size_bytes", "sha256"]}},
        {"if": {"properties": {"verification": {"const": "unverified"}}}, "then": {"not": {"anyOf": [{"required": ["size_bytes"]}, {"required": ["sha256"]}]}}}
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id", "display_name", "kind", "category", "provider", "version", "revision", "runtime_id", "modules", "files",
        "disposition", "install_strategy", "primary_source", "trusted_fallback_sources", "source_identity", "source_verification",
        "latest_upstream_revision", "latest_supported_revision", "license", "authentication", "update_parts",
        "estimated_download_size", "estimated_disk_size", "minimum_vram_mb", "recommended_vram_mb", "notes"
      ],
      "properties": {
        "model_id": {"$ref": "#/$defs/id"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"const": "model"},
        "category": {"type": "string", "minLength": 1, "maxLength": 48},
        "provider": {"type": "string", "minLength": 1, "maxLength": 96},
        "version": {"type": "string", "minLength": 1, "maxLength": 96},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "runtime_id": {"$ref": "#/$defs/id"},
        "modules": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/leaf"}},
        "disposition": {"enum": ["AUTO_INSTALL_READY", "AUTH_REQUIRED", "MANUAL_IMPORT_ONLY", "UNSUPPORTED_SOURCE"]},
        "install_strategy": {"enum": ["portable_archive", "provider_authorization", "manual_import", "unsupported_source"]},
        "primary_source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]},
        "trusted_fallback_sources": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/source"}},
        "source_identity": {"$ref": "#/$defs/nullable_text"},
        "source_verification": {"enum": ["verified", "unverified", "manual", "auth_required", "unsupported", "unknown"]},
        "latest_upstream_revision": {"type": ["string", "null"], "maxLength": 128},
        "latest_supported_revision": {"type": ["string", "null"], "maxLength": 128},
        "license": {"$ref": "#/$defs/license"},
        "authentication": {"$ref": "#/$defs/authentication"},
        "update_parts": {"type": "array", "items": {"enum": ["backend", "runtime", "dependencies", "model"]}},
        "estimated_download_size": {"type": ["integer", "null"], "minimum": 0},
        "estimated_disk_size": {"type": ["integer", "null"], "minimum": 0},
        "minimum_vram_mb": {"type": ["integer", "null"], "minimum": 0},
        "recommended_vram_mb": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"type": "string", "maxLength": 500}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id", "display_name", "kind", "provider", "version", "revision", "root_class", "required_leaves", "modules",
        "disposition", "install_strategy", "primary_source", "trusted_fallback_sources", "source_identity", "source_verification",
        "latest_upstream_revision", "latest_supported_revision", "license", "authentication", "update_parts", "integrity",
        "estimated_download_size", "estimated_disk_size", "notes"
      ],
      "properties": {
        "runtime_id": {"$ref": "#/$defs/id"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"type": "string", "minLength": 1, "maxLength": 48},
        "provider": {"type": "string", "minLength": 1, "maxLength": 96},
        "version": {"type": "string", "minLength": 1, "maxLength": 96},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "root_class": {"enum": ["runtime_root", "environments_root", "external_managed"]},
        "required_leaves": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relative"}},
        "archive_prefix": {"$ref": "#/$defs/relative"},
        "archive_leaves": {"type": "object", "additionalProperties": {"$ref": "#/$defs/relative"}},
        "modules": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "disposition": {"enum": ["AUTO_INSTALL_READY", "REFERENCE_EXISTING", "MANUAL_INSTALL", "UNSUPPORTED_SOURCE"]},
        "install_strategy": {"enum": ["portable_archive", "reference_existing", "manual_install", "unsupported_source"]},
        "primary_source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]},
        "trusted_fallback_sources": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/source"}},
        "source_identity": {"$ref": "#/$defs/nullable_text"},
        "source_verification": {"enum": ["verified", "unverified", "manual", "auth_required", "unsupported", "unknown"]},
        "latest_upstream_revision": {"type": ["string", "null"], "maxLength": 128},
        "latest_supported_revision": {"type": ["string", "null"], "maxLength": 128},
        "license": {"$ref": "#/$defs/license"},
        "authentication": {"$ref": "#/$defs/authentication"},
        "update_parts": {"type": "array", "items": {"enum": ["backend", "runtime", "dependencies", "model"]}},
        "integrity": {"$ref": "#/$defs/integrity"},
        "estimated_download_size": {"type": ["integer", "null"], "minimum": 0},
        "estimated_disk_size": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"type": "string", "maxLength": 500}
      }
    }
  }
}
